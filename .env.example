# Kopie dieser Datei als .env anlegen und Werte anpassen.

# Port des Webservers
PORT=3000

# In der Produktion auf "production" setzen (aktiviert sichere Cookies)
NODE_ENV=production

# Zufälliger, geheimer Wert für die Sitzungsverwaltung.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Zugangsdaten für den ersten Administrator.
# Werden nur beim allerersten Start verwendet, wenn noch kein Konto existiert.
ADMIN_EMAIL=vorstand@rehlacke.at
ADMIN_PASSWORD=

# Optional: abweichende Ablageorte
# DATA_DIR=/var/lib/rehlacke/data
# UPLOAD_DIR=/var/lib/rehlacke/uploads
