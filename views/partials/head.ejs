<!DOCTYPE html>
<html lang="de" <%- typeof themeAttr !== 'undefined' ? themeAttr : '' %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' :: ' + settings.site_title : settings.site_title + ' – ' + settings.site_subtitle %></title>
  <meta name="description" content="<%= description || settings.site_subtitle %>">
  <meta name="theme-color" content="#0f3b2c">
  <meta property="og:title" content="<%= title || settings.site_title %>">
  <meta property="og:description" content="<%= description || settings.site_subtitle %>">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="de_AT">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <script src="/js/theme.js"></script>
</head>
