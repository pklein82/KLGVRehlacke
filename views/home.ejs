<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="hero">
  <svg class="hero__leaves" aria-hidden="true" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice">
    <g fill="none" stroke="currentColor" stroke-width="1.4">
      <circle cx="1040" cy="90" r="180"/>
      <circle cx="1040" cy="90" r="120"/>
      <circle cx="120" cy="520" r="150"/>
      <path d="M-40 470c160-90 320-60 470 30s310 120 470 40"/>
      <path d="M-40 530c160-90 320-60 470 30s310 120 470 40"/>
    </g>
  </svg>

  <div class="wrap hero__inner">
    <div>
      <p class="kicker"><%= settings.hero_kicker %></p>
      <h1><%= settings.hero_title %></h1>
      <p class="hero__lead"><%= settings.hero_text %></p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/aktuelles"><%- icon('news') %> Aktuelles ansehen</a>
        <a class="btn btn--ghost" href="/kontakt"><%- icon('mail') %> Kontakt aufnehmen</a>
      </div>
    </div>

    <dl class="hero__facts">
      <div class="hero__fact">
        <%- icon('pin') %>
        <div>
          <dt>Anlage</dt>
          <dd><%= settings.street %><br><%= settings.zip %> <%= settings.city %></dd>
        </div>
      </div>
      <% if (settings.office_hours) { %>
      <div class="hero__fact">
        <%- icon('clock') %>
        <div>
          <dt>Sprechstunde</dt>
          <dd><%= settings.office_hours %></dd>
        </div>
      </div>
      <% } %>
      <% if (settings.email) { %>
      <div class="hero__fact">
        <%- icon('mail') %>
        <div>
          <dt>E-Mail</dt>
          <dd><a href="mailto:<%= settings.email %>"><%= settings.email %></a></dd>
        </div>
      </div>
      <% } %>
      <% if (settings.phone) { %>
      <div class="hero__fact">
        <%- icon('phone') %>
        <div>
          <dt>Telefon</dt>
          <dd><a href="tel:<%= settings.phone.replace(/\s/g, '') %>"><%= settings.phone %></a></dd>
        </div>
      </div>
      <% } %>
    </dl>
  </div>
</section>

<% if (news.length) { %>
<section class="section wrap">
  <div class="section__head">
    <div>
      <p class="kicker">Aktuelles</p>
      <h2>Neues aus dem Verein</h2>
      <p>Mitteilungen der Vereinsleitung, Hinweise zur Anlage und Termine.</p>
    </div>
    <a class="link-more" href="/aktuelles">Alle Beiträge <%- icon('arrow') %></a>
  </div>

  <div class="grid grid--3">
    <% news.forEach(function (item) { %>
      <article class="card card--link reveal">
        <% if (item.image) { %>
          <div class="news-card__image">
            <img src="<%= item.image %>" alt="" loading="lazy">
          </div>
        <% } %>
        <div class="card__meta">
          <time datetime="<%= item.published_at %>"><%= h.formatDate(item.published_at) %></time>
          <% if (item.pinned) { %><span class="tag">Wichtig</span><% } %>
        </div>
        <h3><a class="card__link" href="/aktuelles/<%= item.slug %>"><%= item.title %></a></h3>
        <p><%= item.excerpt || h.plainText(item.body, 140) %></p>
        <span class="link-more">Weiterlesen <%- icon('arrow') %></span>
      </article>
    <% }); %>
  </div>
</section>
<% } %>

<% if (events.length) { %>
<section class="section section--tinted">
  <div class="wrap">
    <div class="section__head">
      <div>
        <p class="kicker">Termine</p>
        <h2>Nächste Veranstaltungen</h2>
        <p>Sprechstunden, Arbeitseinsätze und Feste in der Anlage.</p>
      </div>
      <a class="link-more" href="/termine">Alle Termine <%- icon('arrow') %></a>
    </div>

    <div class="grid grid--2">
      <% events.forEach(function (event) { const d = h.dateParts(event.starts_at); %>
        <article class="card reveal">
          <div class="event event--bare">
            <div class="event__date">
              <span class="event__day"><%= d.day %></span>
              <span class="event__month"><%= d.month %></span>
            </div>
            <div class="event__body">
              <h3><%= event.title %></h3>
              <p class="event__when"><%= h.formatEventRange(event) %><% if (event.location) { %> &middot; <%= event.location %><% } %></p>
              <% if (event.description) { %><p class="event__desc"><%= event.description %></p><% } %>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section wrap">
  <div class="section__head">
    <div>
      <p class="kicker">Wegweiser</p>
      <h2>Wichtige Informationen</h2>
      <p>Die Seiten, die Mitglieder am häufigsten brauchen.</p>
    </div>
  </div>

  <div class="grid grid--3">
    <% const quickIcons = { ruhezeiten: 'clock', kosten: 'euro', gartenfachberatung: 'plant', verein: 'users', lageplan: 'map', links: 'external' }; %>
    <% highlights.concat(services).slice(0, 6).forEach(function (page) { %>
      <article class="card card--link reveal">
        <span class="card__icon"><%- icon(quickIcons[page.slug] || 'book') %></span>
        <h3><a class="card__link" href="/<%= page.slug %>"><%= page.nav_title || page.title %></a></h3>
        <p><%= page.intro || '' %></p>
        <span class="link-more">Mehr erfahren <%- icon('arrow') %></span>
      </article>
    <% }); %>

    <article class="card card--link reveal">
      <span class="card__icon"><%- icon('download') %></span>
      <h3><a class="card__link" href="/downloads">Downloads</a></h3>
      <p>Statuten, Gartenordnung, Beschlüsse der Hauptversammlung und Formulare.</p>
      <span class="link-more">Zum Downloadbereich <%- icon('arrow') %></span>
    </article>

    <article class="card card--link reveal">
      <span class="card__icon"><%- icon('tag') %></span>
      <h3><a class="card__link" href="/flohmarkt">Ich biete / Ich suche</a></h3>
      <p>Pflanzen, Werkzeug und Gartenzubehör innerhalb des Vereins weitergeben.</p>
      <span class="link-more">Anzeigen ansehen <%- icon('arrow') %></span>
    </article>

    <article class="card card--link reveal">
      <span class="card__icon"><%- icon('users') %></span>
      <h3><a class="card__link" href="/vereinsleitung">Vereinsleitung</a></h3>
      <p>Wer welche Funktion ausübt und wie Sie die Vereinsleitung erreichen.</p>
      <span class="link-more">Zur Vereinsleitung <%- icon('arrow') %></span>
    </article>
  </div>
</section>

<%- include('partials/footer') %>
